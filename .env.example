# Copy to /opt/agent/.env on the host (root-owned, chmod 600). Never commit real values.

# ---- Orchestrator ----
WEBHOOK_ADDR=:8080
POOLD_URL=http://localhost:9090          # mock-poold for now; real Poold later
WORKERS=4                                # concurrent tasks; each holds one leased VM
DB_PATH=/opt/agent/memory.db             # SQLite memory store

# ---- Dispatch (how the claude -p job reaches a VM) ----
DISPATCH_MODE=ssh                        # ssh | mock
SSH_KEY=/opt/agent/vm.pem                # -i identity for ssh dispatch (if needed)

# ---- VM bootstrap (a leased VM comes back blank; the orchestrator provisions it) ----
# On dispatch, before `claude -p`, the orchestrator installs claude + gh if they
# are missing and writes the secrets below to a 0600 env file on the VM. Idempotent,
# so a pre-baked image makes it a fast no-op. Set VM_BOOTSTRAP=false to skip it.
VM_BOOTSTRAP=true
GH_VERSION=2.63.2                        # gh version for the tarball fallback install
AGENT_STREAM=true                        # stream claude's steps (stream-json) for the live UI

# ---- LLM (Haiku: signature / match / distill) ----
# LLM_BACKEND: api | cli | stub. Unset => api if ANTHROPIC_API_KEY set, else cli.
LLM_BACKEND=
ANTHROPIC_API_KEY=                       # for the "api" backend
HAIKU_MODEL=claude-haiku-4-5-20251001

# ---- Agent runtime (paths are on the VM, injected into the investigation prompt) ----
VOYAGER_PATH=/opt/agent/voyager
VOYAGER_REPO=andromedasec/voyager
S3_BUCKET=as-live-heap-dump
MCP_CONFIG=/opt/agent/mcp.json
ALLOWED_TOOLS=Bash,Edit,Write,mcp__datadog__*,mcp__andromeda_gateway__*
CLAUDE_TIMEOUT=900                       # seconds per claude -p run
CLAUDE_BIN=claude

# The secrets below are injected into each leased VM's investigation run (written
# to ~/.config/agent/env on the VM, chmod 600). Set the ones the agent needs.

# ---- Claude Code headless auth (mint with `claude setup-token`) ----
# Used by the cli LLM backend on the box AND injected into the VM so `claude -p` runs.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Datadog MCP (us3 site) ----
DD_API_KEY=
DD_APP_KEY=

# ---- GitHub (PAT with repo write on andromedasec/voyager: git push + gh pr create) ----
# Read as GH_TOKEN, falling back to GITHUB_TOKEN; forwarded to the VM as both.
GITHUB_TOKEN=

# ---- AWS — short-lived STS creds for reading s3://as-live-heap-dump ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-west-2
