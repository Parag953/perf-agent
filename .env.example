# Copy to /opt/agent/.env on the host (root-owned, chmod 600). Never commit real values.

# Claude Code headless auth (subscription OAuth token from `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# Datadog MCP (us3 site)
DD_API_KEY=
DD_APP_KEY=

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# GitHub (org-scoped PAT with Contents: Read on andromedasec/voyager + repo write for PRs)
GITHUB_TOKEN=

# AWS — short-lived STS creds for reading s3://as-live-heap-dump
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-west-2
